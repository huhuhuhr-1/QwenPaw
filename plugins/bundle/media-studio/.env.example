# MiniMax（文本精修必填）
MINIMAX_API_KEY=

# 旧版全局 Whisper（主要给慢队列提供默认模型路径）
MEDIA_STUDIO_MODEL_PATH=~/.cache/qwenpaw/models/whisper-large-v3
MEDIA_STUDIO_DEVICE=cpu
MEDIA_STUDIO_COMPUTE_TYPE=int8

# --- 转写队列：快=GPU，慢=CPU，云端=API（都用 faster-whisper 或 OpenAI 兼容接口）---
# 未启用或未配置的队列不会接到任务；上传 API 不变，内部自动选队列
MEDIA_STUDIO_TRANSCRIBE_DEFAULT_LANE=fast
MEDIA_STUDIO_TRANSCRIBE_FAST_ENABLED=true
MEDIA_STUDIO_TRANSCRIBE_SLOW_ENABLED=true
MEDIA_STUDIO_TRANSCRIBE_EXTERNAL_ENABLED=false

MEDIA_STUDIO_TRANSCRIBE_FAST_BACKEND=local
MEDIA_STUDIO_TRANSCRIBE_SLOW_BACKEND=local
MEDIA_STUDIO_TRANSCRIBE_EXTERNAL_BACKEND=openai

# 快队列：GPU + 大模型（默认与 MEDIA_STUDIO_MODEL_PATH 一致）
# MEDIA_STUDIO_TRANSCRIBE_FAST_MODEL_PATH=~/.cache/qwenpaw/models/whisper-large-v3
MEDIA_STUDIO_TRANSCRIBE_FAST_DEVICE=cuda
MEDIA_STUDIO_TRANSCRIBE_FAST_COMPUTE_TYPE=int8_float16

# 慢队列：CPU + 小模型（兜底，不占 GPU）
# 执行 scripts/download_whisper_model.py 下载到 ~/.cache/qwenpaw/models/
# MEDIA_STUDIO_TRANSCRIBE_SLOW_MODEL_PATH=models/models--Systran--faster-whisper-small/snapshots/...
MEDIA_STUDIO_TRANSCRIBE_SLOW_DEVICE=cpu
MEDIA_STUDIO_TRANSCRIBE_SLOW_COMPUTE_TYPE=int8

# 云端（外部队列）
# MEDIA_STUDIO_TRANSCRIBE_OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# MEDIA_STUDIO_TRANSCRIBE_EXTERNAL_BACKEND=dashscope

# 并发
# MEDIA_STUDIO_MAX_CONCURRENT_TRANSCRIBE_FAST=1
# MEDIA_STUDIO_MAX_CONCURRENT_TRANSCRIBE_SLOW=1
MEDIA_STUDIO_MAX_CONCURRENT_EXTRACT=2
MEDIA_STUDIO_MAX_CONCURRENT_POLISH=2

MEDIA_STUDIO_LOG_LEVEL=INFO
WEB_PORT=8080
